#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
usage: ./bootstrap [desktop|home-server] [mise bootstrap options]

Profiles:
  desktop      load -E macos-arm64 -E desktop (default)
  home-server  load -E macos-arm64 -E home-server

Options:
  -h, --help       show this help
  --list-profiles  print supported profile names

All arguments after the profile are forwarded to `mise bootstrap`.
Running mise without -E loads only mise.toml; it does not load the shared
macOS packages/dotfiles/defaults or either host profile.

Examples:
  ./bootstrap
  ./bootstrap desktop
  ./bootstrap desktop --dry-run
  ./bootstrap home-server --only packages
EOF
}

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  --list-profiles)
    printf '%s\n' desktop home-server
    exit 0
    ;;
esac

profile="${1:-desktop}"
if [ "$#" -gt 0 ]; then
  shift
fi
case "$profile" in
  desktop|home-server) ;;
  *)
    usage >&2
    exit 64
    ;;
esac

repo_dir=$(cd -- "$(dirname -- "$0")" && pwd)
cd "$repo_dir"

if ! command -v mise >/dev/null 2>&1; then
  echo "mise is required. Install it with: brew install mise" >&2
  exit 127
fi

exec mise -E macos-arm64 -E "$profile" bootstrap --yes "$@"
